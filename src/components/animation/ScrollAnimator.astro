---
interface Props {
  target?: string;
  animation?: 'slide-up'|'slide-left'|'fade'|'scale'|'blur'|'rotate';
  mode?: 'follow'|'threshold';
  range?: number;
}

const {
  target = '#header3',
  animation = 'slide-up',
  mode = 'follow',
  range = 300,
} = Astro.props;
---

<style is:global>
  [data-scroll-animated] {
    will-change: transform, opacity, filter;
    transform-style: preserve-3d;
    backface-visibility: hidden;
    transform-origin: center top;
    transition:
      transform 0.70s cubic-bezier(.22,.9,.34,1),
      opacity 0.70s cubic-bezier(.22,.9,.34,1),
      filter 0.735s cubic-bezier(.22,.9,.34,1);
  }

  [data-scroll-animated].hidden {
    opacity: 0;
    pointer-events: none;
  }

  @media (orientation: portrait) {
    [data-scroll-animated] {
      transition:
        transform 0.45s cubic-bezier(.25,.8,.25,1),
        opacity 0.45s cubic-bezier(.25,.8,.25,1),
        filter 0.50s cubic-bezier(.25,.8,.25,1);
      -webkit-transform: translateZ(0);
      transform: translateZ(0);
    }
  }
</style>

<script define:vars={{ target, animation, mode, range }}>
  if (typeof window !== 'undefined') {
    window.addEventListener('DOMContentLoaded', () => {
      const TARGET_SELECTOR = target;
      const DEFAULT_ANIM = animation;
      const DEFAULT_MODE = mode;
      const DEFAULT_RANGE = range;

      const rawEl = document.querySelector(TARGET_SELECTOR);
      if (!rawEl) return;

      // Add data attribute for styling
      rawEl.setAttribute('data-scroll-animated', 'true');

      /** @type {HTMLElement} */
      const el = /** @type {HTMLElement} */ (rawEl);

      // keys de storage
      const KEY_ANIM = 'scrollAnimatorAnim';
      const KEY_MODE = 'scrollAnimatorMode';
      const KEY_RANGE = 'scrollAnimatorRange';

      // leer guardados
      const savedAnim = localStorage.getItem(KEY_ANIM) || DEFAULT_ANIM;
      const savedMode = localStorage.getItem(KEY_MODE) || DEFAULT_MODE;
      const savedRangeRaw = localStorage.getItem(KEY_RANGE);
      const savedRange = savedRangeRaw ? Number(savedRangeRaw) : DEFAULT_RANGE;
      const finalRange = Number.isFinite(savedRange) ? savedRange : DEFAULT_RANGE;

      // aplicar dataset para debugging/runtime
      el.dataset.animation = savedAnim;
      el.dataset.scrollMode = savedMode;
      el.dataset.scrollRange = String(finalRange);

      /** 
       * @param {number} v
       * @param {number} [a]
       * @param {number} [b]
       * @returns {number}
       */
      const clamp = (v, a = 0, b = 1) => Math.max(a, Math.min(b, v));

      let lastScroll = window.scrollY || 0;
      let ticking = false;

      const isPortrait = () => window.matchMedia('(orientation: portrait)').matches;

      /**
       * Aplica la transformación según el progreso
       * @param {number} progress - 0 visible, 1 oculto
       * @param {string} anim
       * @returns {void}
       */
      function applyProgress(progress, anim) {
        const portrait = isPortrait();
        
        switch (anim) {
          case 'slide-up': {
            const ty = portrait ? -85 * progress : -120 * progress;
            const opacity = portrait ? 1 - progress * 0.95 : 1 - progress;
            el.style.transform = `translateY(${ty}vh) translateZ(0)`;
            el.style.opacity = String(opacity);
            el.style.filter = 'none';
            break;
          }
          case 'slide-left': {
            const tx = portrait ? -90 * progress : -120 * progress;
            const opacity = portrait ? 1 - progress * 0.95 : 1 - progress;
            el.style.transform = `translateX(${tx}vw) translateZ(0)`;
            el.style.opacity = String(opacity);
            el.style.filter = 'none';
            break;
          }
          case 'fade': {
            const ty = portrait ? -12 * progress : -18 * progress;
            const opacity = portrait ? 1 - progress * 0.98 : 1 - progress;
            el.style.transform = `translateY(${ty}px) translateZ(0)`;
            el.style.opacity = String(opacity);
            el.style.filter = 'none';
            break;
          }
          case 'scale': {
            const s = 1 - (portrait ? 0.06 : 0.12) * progress;
            const ty = portrait ? -15 * progress : -22 * progress;
            el.style.transform = `translateY(${ty}px) scale(${s}) translateZ(0)`;
            el.style.opacity = String(1 - progress * (portrait ? 0.85 : 0.9));
            el.style.filter = 'none';
            break;
          }
          case 'blur': {
            const ty = portrait ? -12 * progress : -20 * progress;
            const blurPx = portrait ? 3 * progress : 6 * progress;
            const saturate = 1 - progress * (portrait ? 0.05 : 0.1);
            el.style.transform = `translateY(${ty}px) translateZ(0)`;
            el.style.opacity = String(1 - progress * (portrait ? 0.92 : 0.95));
            el.style.filter = `blur(${blurPx}px) saturate(${saturate})`;
            break;
          }
          case 'rotate': {
            const ty = portrait ? -28 * progress : -48 * progress;
            const r = portrait ? -4 * progress : -8 * progress;
            const scale = 1 - progress * (portrait ? 0.01 : 0.02);
            el.style.transform = `translateY(${ty}px) rotate(${r}deg) scale(${scale}) translateZ(0)`;
            el.style.opacity = String(1 - progress * (portrait ? 0.92 : 0.95));
            el.style.filter = 'none';
            break;
          }
          default: {
            const ty = portrait ? -100 : -120;
            el.style.transform = `translateY(${ty * progress}vh) translateZ(0)`;
            el.style.opacity = String(1 - progress);
            el.style.filter = 'none';
          }
        }
      }

      /** @returns {void} */
      function resetStyle() {
        el.style.transform = '';
        el.style.opacity = '';
        el.style.filter = '';
      }

      /**
       * Handler de umbral (threshold)
       * @param {number} currentScroll
       * @returns {void}
       */
      function thresholdHandler(currentScroll) {
        if (currentScroll > lastScroll && currentScroll > 50) {
          el.classList.add('hidden');
        } else {
          el.classList.remove('hidden');
        }
      }

      /**
       * Obtener settings dinámicos
       * @returns {{anim:string, mode:string, range:number}}
       */
      function getSettings() {
        const anim = el.dataset.animation || savedAnim;
        const modeNow = el.dataset.scrollMode || savedMode;
        const rangeNow = Number(localStorage.getItem(KEY_RANGE) || String(finalRange));
        return { anim, mode: modeNow, range: rangeNow };
      }

      const getMobileRange = (baseRange) => {
        return isPortrait() ? Math.min(baseRange, 250) : baseRange;
      };

      window.addEventListener('scroll', () => {
        const currentScroll = window.scrollY || 0;

        if (!ticking) {
          window.requestAnimationFrame(() => {
            const { anim, mode: modeNow, range: rangeNow } = getSettings();
            const effectiveRange = getMobileRange(rangeNow);

            if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
              thresholdHandler(currentScroll);
            } else if (modeNow === 'threshold') {
              thresholdHandler(currentScroll);
            } else {
              const progress = clamp(currentScroll / Math.max(1, effectiveRange), 0, 1);

              if (progress <= 0) {
                resetStyle();
                el.classList.remove('hidden');
                el.setAttribute('aria-hidden', 'false');
              } else if (progress >= 1) {
                applyProgress(1, anim);
                el.classList.add('hidden');
                el.setAttribute('aria-hidden', 'true');
              } else {
                applyProgress(progress, anim);
                el.classList.remove('hidden');
                el.setAttribute('aria-hidden', 'false');
              }
            }

            lastScroll = currentScroll <= 0 ? 0 : currentScroll;
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });
    });
  }
</script>
