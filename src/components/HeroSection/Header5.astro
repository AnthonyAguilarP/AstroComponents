---
import headerImg from '../../assets/postre.webp';
---

<header>
    <div>
        <h1><span>Saborea</span> lo dulce de la vida</h1>
    </div>
    <img src={headerImg.src} alt="Header Image" />
</header>

<style>
  header {
    position: relative;
    width: 100vw;
    height: 100vh;
    display: flex;
    z-index: 1;
    justify-content: center;
    align-items: center;
  }

  header::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('src/assets/header.png');
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center center;
    z-index: -1;
    opacity: 0.05;
  }

  header img {
    width: 30vw;
    height: 35vh;
    margin-left: 8vw;
    z-index: 2;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    object-fit: cover;
  }
  h1 {
    color: #000000;
    font-size: 5vh;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.014);
  }
  h1 span {
    color: #D0203D;
  }
</style>
