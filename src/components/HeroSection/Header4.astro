---
import png from '../../assets/png.png';
---

<header>
    <h1>Try</h1>
    <img src={png.src} alt="PNG">
    <h2 class="first">Turn</h2>
    <h2 class="second">Around</h2>
</header>

<style>
    header {
        position: relative;
        width: 100vw;
        height: 100vh;
    }

    h1 {
        font-size: 10vh;
        margin-left: 20vw;
        color: #96a9ae;
    }

    h2 {
        font-size: 5vh;
        margin: 0;
        color: #96a9ae;
    }
    .first {
        margin-left: 50vw;
        margin-top: 50vh;
        margin-bottom: 0;
        padding: 0;
    }
    .second {
        margin-left: 43vw;
        margin-top: 0;
        padding: 0;
    }
    img {
        position: absolute;
        top: 40vh;
        left: 45vw;
        transform: translate(-50%, -50%);
        width: auto;
        height: 55vh;
        opacity: 0.1;
    }
</style>