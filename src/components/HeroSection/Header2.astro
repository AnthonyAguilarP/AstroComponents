---
import Button1 from '../Button/Button.astro';
import backgroundImage from '../../assets/image1.webp';
---

<header class="flex y-center">
    <div class="container">
        <div class="margin">
            <h1>Welcome to Our Website</h1>
            <p>Your journey to excellence starts here.</p>
            <div class="flex">
                <Button1
                    text="Get Started" 
                    href="/prueba"
                    class="heroButton" />

                <Button1
                    text="Learn More" 
                    sectionId='hi'
                    class="heroSecondButton" />
            </div>
        </div>
    </div>
    <div class="container responsive-hide">
        <img src={backgroundImage.src} alt="Background Image" class="margin" />
    </div>
</header>

<style>
    .margin {
        margin: 6vw;
    }

    .container {
        width: 50vw;
    }

    header {
        width: 100vw;
    }

    .flex {
        display: flex;
    }

    .y-center {
        align-items: center;
    }

    img {
        width: 38vw;
        height: auto;
        object-fit: cover;
        border-radius: 20px;
    }

    h1 {
        font-size: 5vh;
        margin-bottom: 2vh;
        width: 38vw;
        text-align: left;
    }

    p {
        font-size: 2vh;
        margin-bottom: 4vh;
        width: 38vw;
        text-align: left;
    }

    .heroButton {
        padding: 1vh 2vh;
        font-size: 2vh;
        background-color: #ff6600;
        color: white;
        border: none;
        border-radius: 0.5vh;
        cursor: pointer;
        box-shadow: 2px 2px 5px rgba(0,0,0,0.3);
    }

    .heroButton:hover {
        background-color: #e65c00;
    }

    .heroSecondButton {
        padding: 1vh 2vh;
        font-size: 2vh;
        background-color: #ffffff;
        color: rgb(0, 0, 0);
        border-radius: 0.5vh;
        border: 2px solid #000000;
        cursor: pointer;
        box-shadow: 2px 2px 5px rgba(0,0,0,0.3);
        margin-left: 1vw;
    }

    .heroSecondButton:hover {
        background-color: #d1d1d1;
    }

@media (orientation: portrait) {
    h1, p {
        width: 80vw;
        margin-left: 10vw;
        text-align: left;
        color: #ffffff;
    }

    header {
        flex-direction: column;
        align-items: stretch;
        position: relative;
    }

    header > .container:first-child {
        width: 100vw;
        position: relative;
        z-index: 3;
    }

    header > .container.responsive-hide {
        position: absolute;
        inset: 0;
        width: 100vw;
        height: 100%;
        margin: 0;
        padding: 0;
        pointer-events: none;
        z-index: 0;
        display: block;
    }

    header > .container.responsive-hide img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: right center;
        border-radius: 0;
        display: block;
    }

    header::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(0,0,0,0.6), rgba(0,0,0,0.3));
        z-index: 1;
        pointer-events: none;
    }


    header > .container:first-child .margin {
        position: relative;
        z-index: 4;
    }

    header > .container:first-child .flex {
        flex-direction: row;
        justify-content: flex-start;
        align-items: center;
        gap: 2vw;
        margin-top: 3vh;
        flex-wrap: wrap;
        margin-left: 10vw;
        margin-bottom: 5vh;
    }

    .heroButton,
    .heroSecondButton {
        width: auto;
        min-width: unset;
        font-size: 2vh;
        padding: 1vh 1vh;
        border-radius: 0.6vh;
    }

    .margin {
        margin: 0vw;
    }
}
</style>
